{
  "name": "mitosis-gun-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "build:single": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "balance": "vitest run tests/balance.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-e2e.cjs smoke",
    "test:e2e:all": "node scripts/run-e2e.cjs all",
    "audit": "vite-node scripts/block-audit.ts",
    "balance-econ": "vite-node scripts/balance-econ.ts",
    "balance-wall": "vite-node scripts/balance-wall.ts",
    "balance-blocks": "vite-node scripts/balance-blocks11a.ts",
    "balance-captains": "vite-node scripts/balance-captains.ts",
    "balance-damage": "vite-node scripts/balance-damage.ts",
    "balance-frontier": "vite-node scripts/balance-frontier.ts",
    "economy-audit": "vite-node scripts/economy-audit.ts",
    "blocks-doc": "vite-node scripts/blocks-doc.ts",
    "interaction-audit": "vite-node scripts/interaction-audit.ts",
    "perf-legendary": "vite-node scripts/perf-legendary.ts",
    "perf-profile": "vite-node scripts/perf-profile.ts",
    "difficulty-audit": "vite-node scripts/difficulty-audit.ts",
    "make-icons": "node scripts/make-icons.cjs"
  },
  "devDependencies": {
    "@vitest/ui": "^2.1.2",
    "playwright": "^1.63.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "pixi.js": "^8.3.4"
  }
}
